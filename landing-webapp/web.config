<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service (Windows / iisnode) configuration for the Clumo landing page.
  Serves static assets (including the demo mp4) directly via IIS and routes
  everything else to the Node server. Ignored on Linux App Service, where
  `npm start` (server.js) handles all requests.
-->
<configuration>
  <system.webServer>
    <!-- Register the iisnode handler for the Node entry point -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- Make sure common media/static MIME types are served correctly -->
    <staticContent>
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- Serve real files (index.html, clumo-demo.mp4, css, images...) as static content -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="([\S]+\.(?:html|htm|js|css|mp4|webm|png|jpe?g|gif|svg|ico|json|woff2?))$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}" />
        </rule>

        <!-- Everything else goes to the Node app -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Allow large static responses (the demo video is ~44MB) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
